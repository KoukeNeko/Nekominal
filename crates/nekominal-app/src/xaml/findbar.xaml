<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
        Margin="0,10,22,0" Padding="8" CornerRadius="{StaticResource NkCornerRadius}" BorderThickness="1">
  <StackPanel Orientation="Horizontal" Spacing="6">
    <TextBox x:Name="FindInput" Width="230" PlaceholderText="{{edit.find}}" CornerRadius="{StaticResource NkCornerRadius}"/>
    <TextBlock x:Name="FindCount" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" Opacity="0.7"/>
    <Button x:Name="FindPrevious" Style="{StaticResource NkIconButton}" Width="30" Height="30">
      <FontIcon Glyph="&#xE70E;" FontSize="12"/>
    </Button>
    <Button x:Name="FindNext" Style="{StaticResource NkIconButton}" Width="30" Height="30">
      <FontIcon Glyph="&#xE70D;" FontSize="12"/>
    </Button>
    <Button x:Name="FindClose" Style="{StaticResource NkIconButton}" Width="30" Height="30">
      <FontIcon Glyph="&#xE711;" FontSize="12"/>
    </Button>
  </StackPanel>
</Border>

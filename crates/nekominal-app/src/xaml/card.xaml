<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Card" MinHeight="56" Padding="16,8" CornerRadius="{StaticResource NkCornerRadius}" BorderThickness="1"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <TextBlock x:Name="CardTitle" VerticalAlignment="Center" TextWrapping="Wrap"/>
  <ContentControl x:Name="CardSlot" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                  HorizontalContentAlignment="Right" IsTabStop="False"/>
</Grid>

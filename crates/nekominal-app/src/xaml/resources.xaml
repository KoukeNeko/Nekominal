<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette brushes. The shell overwrites their colours from the terminal colour scheme; everything below
         refers to them with StaticResource, so one assignment recolours the whole chrome. -->
    <SolidColorBrush x:Key="NkText" Color="#FFC0CAF5"/>
    <SolidColorBrush x:Key="NkTextSecondary" Color="#9EC0CAF5"/>
    <SolidColorBrush x:Key="NkHover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="NkPressed" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="NkCluster" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="NkDivider" Color="#1FC0CAF5"/>
    <SolidColorBrush x:Key="NkAccent" Color="#FF7AA2F7"/>
    <SolidColorBrush x:Key="NkInk" Color="#FF1A1B26"/>

    <!-- The one corner radius (design.rs CORNER_RADIUS fills the placeholder). ControlCornerRadius and
         OverlayCornerRadius are the keys WinUI's own controls read: buttons, text boxes, combo boxes, the
         InfoBar, scrollbar thumbs (control) and flyouts, menus, dialogs, tooltips (overlay). -->
    <CornerRadius x:Key="NkCornerRadius">@CORNER_RADIUS@</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">@CORNER_RADIUS@</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">@CORNER_RADIUS@</CornerRadius>

    <!-- Square tool button: no fill at rest, translucent plate on hover and press. -->
    <Style x:Key="NkIconButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource NkCornerRadius}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource NkText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualMargin" Value="-2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Hit" Background="Transparent">
              <Border x:Name="Plate" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent">
                <Border.BackgroundTransition>
                  <BrushTransition Duration="0:0:0.12"/>
                </Border.BackgroundTransition>
              </Border>
              <ContentPresenter x:Name="Presenter" Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Plate.Background" Value="{StaticResource NkHover}"/>
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Plate.Background" Value="{StaticResource NkPressed}"/>
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Presenter.Opacity" Value="0.4"/>
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ResourceDictionary>

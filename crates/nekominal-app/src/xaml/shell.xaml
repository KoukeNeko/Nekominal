<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Language="zh-TW">

  <Grid.RowDefinitions>
    <RowDefinition Height="48"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Row 0: the top bar. One row, no fill of its own: a tint of the scheme background (set in code) keeps
       the title text legible and the same backdrop shows through the bar and the terminal. -->
  <Grid x:Name="TopBar" Height="48">
    <Border x:Name="BarTint" Background="Transparent"/>
    <Border x:Name="BarLine" Height="1" VerticalAlignment="Bottom" Background="{StaticResource NkDivider}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftInsetColumn" Width="0"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="40"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="RightInsetColumn" Width="138"/>
      </Grid.ColumnDefinitions>

      <!-- The cat of assets/icon.svg: ears and head in the accent, the prompt cut out in the scheme ink. -->
      <Viewbox x:Name="AppMark" Grid.Column="1" Width="22" Height="22" Margin="14,0,10,0" IsHitTestVisible="False"
               VerticalAlignment="Center">
        <Canvas Width="1024" Height="1024">
          <Polygon Points="212,440 212,190 440,336" Fill="{StaticResource NkAccent}"/>
          <Polygon Points="812,440 812,190 584,336" Fill="{StaticResource NkAccent}"/>
          <Ellipse Canvas.Left="182" Canvas.Top="330" Width="660" Height="540" Fill="{StaticResource NkAccent}"/>
          <Polyline Points="400,520 500,590 400,660" Stroke="{StaticResource NkInk}" StrokeThickness="56"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line X1="548" Y1="676" X2="664" Y2="676" Stroke="{StaticResource NkInk}" StrokeThickness="56"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
      </Viewbox>

      <ScrollViewer x:Name="TabScroll" Grid.Column="2" VerticalAlignment="Center"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" IsTabStop="False">
        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4" Padding="2,0"/>
      </ScrollViewer>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
        <Button x:Name="NewTabButton" Style="{StaticResource NkIconButton}">
          <FontIcon Glyph="&#xE710;" FontSize="13"/>
        </Button>
        <Button x:Name="NewTabMenuButton" Style="{StaticResource NkIconButton}" Width="22">
          <FontIcon Glyph="&#xE70D;" FontSize="9"/>
        </Button>
      </StackPanel>

      <!-- The window drag area: the only element handed to SetTitleBar, so every other part of the bar is
           ordinary client area. -->
      <Grid x:Name="DragRegion" Grid.Column="4" Background="Transparent"/>

      <Border x:Name="ToolCluster" Grid.Column="5" CornerRadius="{StaticResource NkCornerRadius}" Padding="2" Margin="8,0,10,0"
              VerticalAlignment="Center" Background="{StaticResource NkCluster}">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ToolSplitRight" Style="{StaticResource NkIconButton}">
            <Canvas Width="16" Height="16">
              <Path Stroke="{StaticResource NkText}" StrokeThickness="1.3" StrokeLineJoin="Round"
                    Data="M3,2.75 H13 A1.25,1.25 0 0 1 14.25,4 V12 A1.25,1.25 0 0 1 13,13.25 H3 A1.25,1.25 0 0 1 1.75,12 V4 A1.25,1.25 0 0 1 3,2.75 Z M8.5,2.75 V13.25"/>
            </Canvas>
          </Button>
          <Button x:Name="ToolSplitDown" Style="{StaticResource NkIconButton}">
            <Canvas Width="16" Height="16">
              <Path Stroke="{StaticResource NkText}" StrokeThickness="1.3" StrokeLineJoin="Round"
                    Data="M3,2.75 H13 A1.25,1.25 0 0 1 14.25,4 V12 A1.25,1.25 0 0 1 13,13.25 H3 A1.25,1.25 0 0 1 1.75,12 V4 A1.25,1.25 0 0 1 3,2.75 Z M1.75,8 H14.25"/>
            </Canvas>
          </Button>
          <Border Width="1" Height="16" Margin="3,0" Background="{StaticResource NkDivider}"/>
          <Button x:Name="ToolSearch" Style="{StaticResource NkIconButton}">
            <FontIcon Glyph="&#xE721;" FontSize="14"/>
          </Button>
          <Button x:Name="ToolPalette" Style="{StaticResource NkIconButton}">
            <Canvas Width="16" Height="16">
              <Path Stroke="{StaticResource NkText}" StrokeThickness="1.3" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M3,2.75 H13 A1.25,1.25 0 0 1 14.25,4 V12 A1.25,1.25 0 0 1 13,13.25 H3 A1.25,1.25 0 0 1 1.75,12 V4 A1.25,1.25 0 0 1 3,2.75 Z M4.9,6 L7.1,8 L4.9,10 M8.6,10.2 H11.2"/>
            </Canvas>
          </Button>
          <Button x:Name="ToolAppearance" Style="{StaticResource NkIconButton}">
            <Canvas Width="16" Height="16">
              <Path Stroke="{StaticResource NkText}" StrokeThickness="1.3"
                    Data="M8,1.75 A6.25,6.25 0 1 0 8,14.25 A6.25,6.25 0 1 0 8,1.75 Z"/>
              <Path Fill="{StaticResource NkText}" Data="M8,1.75 A6.25,6.25 0 0 0 8,14.25 Z"/>
            </Canvas>
            <Button.Flyout>
              <Flyout x:Name="AppearanceFlyout" Placement="BottomEdgeAlignedRight">
                <StackPanel Width="244" Spacing="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{{settings.backdrop}}" FontSize="12" Opacity="0.7"/>
                    <RadioButtons x:Name="BackdropChoice" SelectedIndex="0" MaxColumns="2">
                      <RadioButton Content="{{backdrop.acrylic}}" MinWidth="0"/>
                      <RadioButton Content="{{backdrop.mica}}" MinWidth="0"/>
                      <RadioButton Content="{{backdrop.micaAlt}}" MinWidth="0"/>
                      <RadioButton Content="{{backdrop.none}}" MinWidth="0"/>
                    </RadioButtons>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <Grid>
                      <TextBlock Text="{{settings.opacity}}" FontSize="12" Opacity="0.7"/>
                      <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" StepFrequency="1"
                            SmallChange="1" LargeChange="5" IsThumbToolTipEnabled="False"/>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ToolSettings" Style="{StaticResource NkIconButton}">
            <FontIcon Glyph="&#xE713;" FontSize="15"/>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

  <!-- Row 1: the terminal area; overlays (palette, find bar, settings) are appended in code. -->
  <Grid x:Name="Body" Grid.Row="1">
    <Grid x:Name="TerminalArea"/>
    <InfoBar x:Name="MessageBar" CornerRadius="{StaticResource NkCornerRadius}" Severity="Warning" IsOpen="False" IsClosable="True"
             VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,12,16,0" MaxWidth="620">
      <InfoBar.ActionButton>
        <Button x:Name="MessageAction" HorizontalAlignment="Right" Visibility="Collapsed"/>
      </InfoBar.ActionButton>
    </InfoBar>
  </Grid>
</Grid>

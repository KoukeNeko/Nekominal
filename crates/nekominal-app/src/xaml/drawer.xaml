<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DrawerPanel" Visibility="Collapsed" Width="480" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
        CornerRadius="{StaticResource NkCornerRadius}" BorderThickness="1" Background="{StaticResource NkPanel}"
        BorderBrush="{StaticResource NkPanelBorder}">
  <!-- The sheet floats over the terminal in the fill of the other floating panels. It has no blur of its own and no
       dependence on the opacity of the background, so what it says stays readable while that slider moves. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="16,10,8,0" Height="32">
      <TextBlock x:Name="DrawerTitle" Text="{{app.settings}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{StaticResource NkPanelText}"/>
      <Button x:Name="DrawerClose" Style="{StaticResource NkIconButton}" HorizontalAlignment="Right">
        <FontIcon Glyph="&#xE711;" FontSize="12"/>
      </Button>
    </Grid>

    <TextBox x:Name="DrawerSearch" Grid.Row="1" Height="36" Margin="16,8,16,0" PlaceholderText="{{settings.search}}"
             CornerRadius="{StaticResource NkCornerRadius}"/>

    <ScrollViewer x:Name="SectionScroll" Grid.Row="2" Margin="16,8,16,0" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"
                  IsTabStop="False">
      <StackPanel x:Name="DrawerSections" Orientation="Horizontal" Spacing="4" Padding="2"/>
    </ScrollViewer>

    <ScrollViewer x:Name="DrawerScroll" Grid.Row="3" Margin="0,8,0,0" IsTabStop="False" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="DrawerRows" Padding="16,0,16,8"/>
    </ScrollViewer>
    <TextBlock x:Name="DrawerEmpty" Grid.Row="3" Text="{{settings.empty}}" Visibility="Collapsed" Margin="16,16,16,0"
               VerticalAlignment="Top" Foreground="{StaticResource NkPanelTextSecondary}"
               AutomationProperties.LiveSetting="Polite"/>

    <Grid Grid.Row="4" Margin="16,0,16,12">
      <Border Height="1" VerticalAlignment="Top" Background="{StaticResource NkDivider}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button x:Name="DrawerOpenFile" Style="{StaticResource NkButton}" Content="{{app.openSettingsFile}}"/>
        <Button x:Name="DrawerReload" Style="{StaticResource NkButton}" Content="{{app.reloadSettings}}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Border>
